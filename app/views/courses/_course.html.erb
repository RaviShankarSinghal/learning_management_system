<div id="<%= dom_id course %>" class="max-w-sm rounded-b overflow-hidden shadow-lg hover:bg-voodoo-100">
  <%= link_to course, class: "flex flex-col h-full" do %>
    <%= image_tag("https://placehold.co/300")%>
    <div class="px-6 py-4 flex flex-col justify-between grow">
      <div>
        <div class="flex items-center justify-between font-bold text-xl mb-2">
          <%= course.title%>
        </div>
        <p class="text-sm font-extralight">
          Ravi Shankar Singhal
        </p>
        <div>
          <p class="text-md font-light">Free<%#= course.paid ? 'Premium Content' : 'Free'%></p>
        </div>
      </div>
    </div>
    <div class="px-6 py-4">
      <div class="font-bold text-xl mb-2"><%#=  course.name%></div>
      <p class="text-gray-700 text-base">
        <%#= course.description%>
      </p>
    </div>
    <div class="px-6 py-4 mt-auto">
      <span class="inline-block bg-gray-200 rounded-full px-3 py-1 text-sm font-bold">
        <%#= course.category.name%>
      </span>
      <span class="inline-block bg-gray-200 rounded-full px-3 py-1 text-sm font-bold">
        <%#= course.difficulty%>
      </span>
      <span class="inline-block bg-gray-200 rounded-full px-3 py-1 text-sm font-bold">
        <%#= course.duration%>
      </span>
    </div>
  <% end %>
</div>
